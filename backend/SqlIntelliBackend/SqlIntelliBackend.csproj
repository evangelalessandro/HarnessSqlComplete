<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <!--
      VULNERABILITÀ SANATA: System.Security.Cryptography.Pkcs 9.0.13 arrivava in modo TRANSITIVO da
      Microsoft.Data.SqlClient 7.0.2 (dipendenza "≥ 8.0.1": NuGet prendeva la 9.0.13) ed è affetta da
      GHSA-2fmv-rv2c-59x7 / CVE-2026-70162 (denial of service, severità media; intervalli
      >= 9.0.0 <= 9.0.20 e >= 10.0.0 <= 10.0.12). Qui la si porta ESPLICITAMENTE alla 10.0.13 (fuori
      dagli intervalli vulnerabili): NuGet unifica sulla versione più alta, quindi la transitiva viene
      sostituita. Aggiornare questa riga quando esce una patch più recente.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
