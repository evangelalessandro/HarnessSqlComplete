<?xml version="1.0" encoding="utf-8"?>
<!--
  Configurazione NuGet del progetto.

  Perché serve: il NuGet.Config dell'utente contiene un `<packageSourceMapping>` che mappa
  solo il pacchetto "AvalonEdit" (più un pattern "nuget.org" che non è un id di pacchetto).
  Con il mapping attivo, tutti gli altri pacchetti — Microsoft.Data.SqlClient,
  Microsoft.EntityFrameworkCore.Sqlite, Microsoft.AspNetCore.OpenApi, ... — non hanno
  nessuna origine consentita e il restore fallisce con NU1100.

  Questa configurazione vale solo per questo repository, non tocca quella dell'utente:
  usa nuget.org e mappa tutti i pacchetti su di essa.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
